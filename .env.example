# Configuracao do ambiente OmniBoard
# Renomeie este arquivo para .env e ajuste os valores antes de subir o projeto.

# PostgreSQL
POSTGRES_USER=omniboard_admin
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=omniboard_db

# String de conexao usada pelo backend (asyncpg)
# Em execucao local (fora do docker), use: postgresql+asyncpg://omniboard_admin:sua_senha@localhost:5432/omniboard_db
# Em execucao dentro do docker compose, use:        postgresql+asyncpg://omniboard_admin:sua_senha@db:5432/omniboard_db
DATABASE_URL=postgresql+asyncpg://omniboard_admin:troque_por_uma_senha_forte@db:5432/omniboard_db

# Redis
# Em execucao local, use: redis://localhost:6379/0
# Em execucao dentro do docker compose, use: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Autenticacao JWT
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque_por_uma_chave_secreta_forte

# Configuracoes opcionais de desenvolvimento
LOG_LEVEL=INFO
