# Configuracao do ambiente OmniBoard
# Renomeie este arquivo para .env e ajuste os valores antes de subir o projeto.

# PostgreSQL
POSTGRES_USER=omniboard_admin
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=omniboard_db
# Para desenvolvimento local (fora do Docker): use localhost
# Para Docker Compose: use db (nome do servico)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# String de conexao usada pelo backend (asyncpg)
# Em execucao local (fora do docker), use: postgresql+asyncpg://omniboard_admin:sua_senha@localhost:5432/omniboard_db
# Em execucao dentro do docker compose, use:        postgresql+asyncpg://omniboard_admin:sua_senha@db:5432/omniboard_db
DATABASE_URL=postgresql+asyncpg://omniboard_admin:troque_por_uma_senha_forte@localhost:5432/omniboard_db

# Redis
# Em execucao local, use: redis://localhost:6379/0
# Em execucao dentro do docker compose, use: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Autenticacao JWT
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque_por_uma_chave_secreta_forte

# OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Push Notifications (Firebase)
# Caminho para o arquivo JSON da service account do Firebase
FIREBASE_SERVICE_ACCOUNT_JSON=

# Observabilidade (OpenTelemetry)
# Para desenvolvimento local, deixe vazio para usar console exporter
# Para producao com Tempo: http://tempo:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# Configuracoes opcionais de desenvolvimento
LOG_LEVEL=INFO
