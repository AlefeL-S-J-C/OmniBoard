# Caddyfile for OmniBoard
# 
# For local development:
#   - Run: caddy run --config Caddyfile.dev
# 
# For production:
#   - Replace omniboard.example.com with your actual domain
#   - Run: docker compose -f docker-compose.prod.yml up -d

{
    admin off
    # email your-email@example.com  # Uncomment for production
}

# Local development (accessible via localhost)
localhost {
    handle_path /api/* {
        reverse_proxy http://web:8000
    }
    handle_path /ws/* {
        reverse_proxy http://web:8000
    }
    handle {
        reverse_proxy http://frontend:80
    }
}

