# Caddyfile for local development
# Run with: caddy run --config Caddyfile.dev

{
    admin off
}

localhost {
    handle_path /api/* {
        reverse_proxy http://localhost:8000
    }
    handle_path /ws/* {
        reverse_proxy http://localhost:8000
    }
    handle {
        reverse_proxy http://localhost:5173
    }
}